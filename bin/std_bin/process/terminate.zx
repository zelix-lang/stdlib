package std_bin::process;

import std_bin::unsafe_boundary::no_mangle;
import std_bin::unsafe_boundary::std_mangle;

@std_bin::unsafe_boundary::no_mangle
unsafe fun exit(code: num): nothing;

@std_bin::unsafe_boundary::std_process_mangle
pub fun terminate(code: num): nothing {
    exit(code);
}