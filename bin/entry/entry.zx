package std_bin::unsafe_boundary;

import std::unsafe_boundary::no_mangle;

@std::unsafe_boundary::no_mangle
unsafe fun main_main(): nothing;

@std::unsafe_boundary::no_mangle
pub fun main(): num {
    main_main();
    return 0;
}